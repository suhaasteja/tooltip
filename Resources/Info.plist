<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>AskAI</string>
	<key>CFBundleIdentifier</key>
	<string>com.yourname.AskAI</string>
	<key>CFBundleName</key>
	<string>AskAI</string>
	<key>CFBundleDisplayName</key>
	<string>AskAI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<!-- Four fixed slots. NSServices is read at registration time and cannot be
	     changed at runtime, so the TITLES are frozen here while the prompt
	     BODIES stay user-editable in UserDefaults. Each NSMessage resolves to
	     askAIN:userData:error: on ServiceProvider. Adding a slot means editing
	     this file, adding the matching @objc method, re-signing, and
	     re-installing. -->
	<!-- Local model servers (LiteLLM proxy, Ollama, LM Studio) listen on plain
	     HTTP at localhost. NSAllowsLocalNetworking permits cleartext to
	     loopback and .local only; it does NOT weaken ATS for the public
	     internet the way NSAllowsArbitraryLoads would. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMessage</key>
			<string>askAI1</string>
			<key>NSPortName</key>
			<string>AskAI</string>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Ask AI: Explain</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
			<!-- Must be present even when empty, or the service never appears
			     anywhere, with no error logged. PLAN.md appendix #1. -->
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
		<dict>
			<key>NSMessage</key>
			<string>askAI2</string>
			<key>NSPortName</key>
			<string>AskAI</string>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Ask AI: Summarise</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
		<dict>
			<key>NSMessage</key>
			<string>askAI3</string>
			<key>NSPortName</key>
			<string>AskAI</string>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Ask AI: Translate</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
		<dict>
			<key>NSMessage</key>
			<string>askAI4</string>
			<key>NSPortName</key>
			<string>AskAI</string>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Ask AI: Custom</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
